{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "default_locale": "en",
  "version": "1.7.0",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://fsweb.no/studentweb/velgInstitusjon.jsf*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://fsweb.no/studentweb/login.jsf*",
        "https://studentweb.uio.no/studentweb/login.jsf*"
      ],
      "js": ["login.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://idp.feide.no/simplesaml/module.php/feide/selectorg*"],
      "js": ["institutions.js", "feide.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "options.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "autofill-for-studentweb@mahofseth",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
