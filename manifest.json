{
  "manifest_version": 3,
  "name": "StudentWeb Default Institution",
  "version": "1.5.1",
  "description": "Remembers your institution on the StudentWeb 'Choose institution' page and preselects it (or skips the page), picks your default login method, and preselects it on Feide's organisation picker.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://fsweb.no/studentweb/velgInstitusjon.jsf*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://fsweb.no/studentweb/login.jsf*",
        "https://studentweb.uio.no/studentweb/login.jsf*"
      ],
      "js": ["login.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://idp.feide.no/simplesaml/module.php/feide/selectorg*"],
      "js": ["institutions.js", "feide.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "StudentWeb Default Institution",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "options.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "studentweb-default-inst@local",
      "strict_min_version": "109.0"
    }
  }
}
